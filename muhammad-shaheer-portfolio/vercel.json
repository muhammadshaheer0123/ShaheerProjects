{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/Muhammad_Shaheer_CV.pdf",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"Muhammad_Shaheer_CV.pdf\"" }]
    }
  ]
}
